{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:s-protocol:consent-workflow:responses:integrative-decision-making:0.2",
  "$defs": {
    "proposal": {
      "type": "object",
      "properties": {
        "tension": {
          "type": "string",
          "minLength": 1
        },
        "proposal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "tension",
        "proposal"
      ],
      "additionalProperties": false
    },
    "questionAction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "question"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "action",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "done"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      ]
    },
    "questionResponse": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "answer"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "action",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "decline"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      ]
    },
    "questionExchange": {
      "oneOf": [
        {
          "$ref": "#/$defs/questionAction"
        },
        {
          "$ref": "#/$defs/questionResponse"
        }
      ]
    },
    "reaction": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "reaction"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "action",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "const": "pass"
            }
          },
          "required": [
            "action"
          ],
          "additionalProperties": false
        }
      ]
    },
    "optionToClarify": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "continue"
            }
          },
          "required": [
            "decision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "clarify"
            },
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "decision",
            "text"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "amend"
            },
            "proposal": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "decision",
            "proposal"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "withdraw"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "decision"
          ],
          "additionalProperties": false
        }
      ]
    },
    "objection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "noObjection"
            }
          },
          "required": [
            "decision"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "decision": {
              "const": "objection"
            },
            "statement": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "decision",
            "statement"
          ],
          "additionalProperties": false
        }
      ]
    },
    "validityDecision": {
      "type": "object",
      "properties": {
        "objectionId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "valid",
            "invalid",
            "withdrawn"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "objectionId",
        "decision"
      ],
      "additionalProperties": false
    },
    "integrationContribution": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false
    },
    "amendment": {
      "type": "object",
      "properties": {
        "proposal": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "proposal"
      ],
      "additionalProperties": false
    },
    "integrationConfirmation": {
      "type": "object",
      "properties": {
        "claim": {
          "enum": [
            "objectionResolved",
            "tensionAddressed"
          ]
        },
        "decision": {
          "enum": [
            "confirmed",
            "notConfirmed"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "claim",
        "decision"
      ],
      "additionalProperties": false
    },
    "applicability": {
      "type": "object",
      "properties": {
        "objectionId": {
          "type": "string",
          "minLength": 1
        },
        "decision": {
          "enum": [
            "stillApplies",
            "withdrawn"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "objectionId",
        "decision"
      ],
      "additionalProperties": false
    }
  }
}
